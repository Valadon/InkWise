{
  "name": "@inkwise/remarkable",
  "version": "0.1.0",
  "description": "Inkwise for reMarkable tablets (reManager / xovi / AppLoad). Reads highlights out of xochitl's .rm page files.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:device": "bun build --compile --target=bun-linux-arm64 --define process.env.INKWISE_VERSION=\\\"$npm_package_version\\\" src/main.ts --outfile dist-device/inkwise-rm"
  },
  "dependencies": {
    "@inkwise/core": "0.1.0",
    "fflate": "^0.8.2"
  }
}
